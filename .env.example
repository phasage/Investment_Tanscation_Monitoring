# Application
APP_ENV=development
APP_NAME=investment-transaction-monitor
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/investment_monitoring
REDIS_URL=redis://localhost:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=investment-transaction-monitoring

# API Keys
MARKET_DATA_API_KEY=your_market_data_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Security
SECRET_KEY=your_secret_key_here
API_KEY_HEADER=X-API-Key

# Model Settings
MODEL_REGISTRY_PATH=models/trained
ANOMALY_THRESHOLD=0.75
RISK_SCORE_HIGH=0.8
RISK_SCORE_MEDIUM=0.5

# Alert Settings
ALERT_EMAIL=alerts@yourcompany.com
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
